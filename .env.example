# Ambiente: development | production | testing
APP_ENV=development
FLASK_DEBUG=1

# Chave secreta do Flask (gere com: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=troque-esta-chave

# Banco SQLite (caminho relativo à raiz do projeto)
DATABASE_PATH=database/lspa.db

# Integração SIDRA/IBGE
SIDRA_TIMEOUT=30
SIDRA_TENTATIVAS=2

# Cache em horas (após o prazo os dados são reconsultados para capturar revisões do IBGE)
CACHE_TTL_HORAS=6
METADADOS_TTL_HORAS=24

# Logs
LOG_LEVEL=INFO
LOG_FILE=logs/lspa.log

# Servidor
FLASK_RUN_HOST=127.0.0.1
FLASK_RUN_PORT=5000
